{
  "name": "innovation-engine",
  "private": true,
  "description": "Static site (no bundler). These scripts are deterministic local checks only -- see docs/VALIDATION.md for known gaps.",
  "scripts": {
    "test": "node scripts/validate.js",
    "lint": "node scripts/lint.js",
    "test:browser": "node scripts/tests/browser/run-assistance-journey.mjs",
    "test:db": "bash scripts/tests/run-db-tests.sh",
    "check:migrations": "node scripts/check-migrations.js",
    "test:xss": "node scripts/tests/browser/run-member-content-xss.mjs",
    "test:logout": "node scripts/tests/browser/run-logout-confirm.mjs",
    "test:responsive": "node scripts/tests/browser/run-responsive-parity.mjs",
    "test:a11y": "node scripts/tests/browser/run-accessibility.mjs",
    "test:admin-review": "node scripts/tests/browser/run-admin-member-review.mjs",
    "test:claim-email": "node scripts/tests/browser/run-claim-email.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0"
  }
}
